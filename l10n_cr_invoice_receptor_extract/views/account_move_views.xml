<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_manual_extract_xml" class="oe_highlight" string="Digitize Manual XML" type="object"
                        invisible="extract_status == 'success' or move_type != 'in_invoice' or state != 'draft' or country_code != 'CR'"/>
            </xpath>
            <field name="invoice_vendor_bill_id" position="after">
                <t groups="purchase.group_purchase_user">
                    <field name="purchase_order_id" invisible="move_type != 'in_invoice'"/>
                </t>
            </field>
            <xpath expr="//header" position='after'>
                <div role="status" class="alert alert-warning text-center" invisible="not nx_warning_message or state != 'draft'">
                    <field name="nx_warning_message" style="white-space: pre-wrap;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
