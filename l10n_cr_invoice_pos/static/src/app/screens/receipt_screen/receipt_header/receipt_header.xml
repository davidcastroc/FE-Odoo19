<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">
    <t t-name="l10n_cr_invoice_pos.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[@class='cashier']" position="after">
            <div class="cr_info">
                <t t-if="env.services.pos.config.l10n_cr_fiscal_journal">
                    <h4 size="double-height" style="margin:5px; padding:0px;">
                        <span style="font-size:130%;" t-if="props.data.voucher_number">
                            <strong>
                                <t t-esc="props.data.voucher_number"/>
                            </strong>
                        </span>
                    </h4>
                    <t t-if="props.data.clave_cr">
                        <div>
                            CLAVE NUMERICA:
                        </div>
                        <div style="font-size: 9.5px;">
                             <t t-esc="props.data.clave_cr"/>
                        </div>
                        <span>
                            CONSECUTIVO: <t t-esc="props.data.number"/>
                        </span>
                        <t t-if="props.data.reference_nc">
                            <br/>
                            <div>
                                CLAVE MODIFICADA:
                            </div>
                            <span style="font-size: 9.5px;">
                                <t t-esc="props.data.reference_nc"/>
                            </span>
                            <br/>
                        </t>
                    </t>
                </t>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
            <div t-if="props.data.partner" class="pos-receipt-partner text-center" style="font-size: 75%;">
                <div>--------------------------------</div>
                <!-- partner informations -->
                <div>CLIENTE: <t t-esc="props.data.partner.name" /></div>
                <t t-if="props.data.partner.vat">
                    IDENTIFICACION:
                    <t t-esc="props.data.partner.vat"/>
                    <br/>
                </t>
                <t t-if="props.data.partner.email">
                    EMAIL:
                    <t t-esc="props.data.partner.email"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
