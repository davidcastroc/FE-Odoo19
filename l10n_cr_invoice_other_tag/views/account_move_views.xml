<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit1" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="terminal_id" position="after">
                <field name="l10n_cr_salesman_number" readonly="state != 'draft'"/>
                <field name="l10n_cr_order_number" readonly="state != 'draft'"/>
                <field name="l10n_cr_pv_number" readonly="state != 'draft'"/>
                <field name="l10n_cr_delivery_date" readonly="state != 'draft'"/>
                <field name="l10n_cr_reception_number" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>
</odoo>
