<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherited" model="ir.ui.view">
        <field name="name">pos.payment.method.view.form.inherited</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="model">pos.payment.method</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="non_document" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
