<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_mh_lookup" model="ir.ui.view">
        <field name="name">res.partner.form.mh.lookup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_consult_res_partner"
                            string="Consultar en MH"
                            type="object"
                            class="oe_highlight"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
