<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catalogo de Bienes y Servicios - CABYS -->
    <record id="view_cr_code_cabys_tree" model="ir.ui.view">
        <field name="name">cr.code.cabys.tree</field>
        <field name="model">ce.product.cabys</field>
        <field name="arch" type="xml">
            <list string="CABYS">
                <field name="code"/>
                <field name="name"/>
                <field name="tax"/>
            </list>
        </field>
    </record>
    <record id="view_cr_code_cabys_form" model="ir.ui.view">
        <field name="name">cr.code.cabys.form</field>
        <field name="model">ce.product.cabys</field>
        <field name="arch" type="xml">
            <form string="CABYS">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="tax"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cabys_search" model="ir.ui.view">
        <field name="name">cr.code.cabys.search</field>
        <field name="model">ce.product.cabys</field>
        <field name="arch" type="xml">
            <search string="CABYS">
                <field name="name" string="Nombre o descripción"/>
                <field name="code" string="Codigo CABYS"/>
            </search>
        </field>
    </record>
    <record id="action_cabys_form" model="ir.actions.act_window">
        <field name="name">CABYS</field>
        <field name="res_model">ce.product.cabys</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
