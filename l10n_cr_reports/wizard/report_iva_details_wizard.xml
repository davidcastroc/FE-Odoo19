<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_cr_reports_details_form" model="ir.ui.view">
        <field name="name">view.l10n.cr.reports.details.form</field>
        <field name="model">l10n_cr_report.details.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen Declaración IVA">
                <group col="4">
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button class="oe_highlight" name="generate_report" string="Generate" type="object"/>
                    <button string="Cancel" class="btn-default" nolabel="1" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_l10n_cr_reports_details" model="ir.actions.act_window">
        <field name="name">Resumen Declaración IVA</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_cr_report.details.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_l10n_cr_reports_details_form"/>
        <field name="target">new</field>
    </record>
    <menuitem id="l10n_cr_reports_details_menu"
              action="action_l10n_cr_reports_details"
              name="Resumen Declaración IVA" parent="account.account_reports_management_menu" sequence="100"/>
</odoo>