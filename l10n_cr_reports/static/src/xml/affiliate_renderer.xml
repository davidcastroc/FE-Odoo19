<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_cr_reports.AffiliateViewHeader">
        <table class="table table-sm table-bordered mb-5 table-loco">
            <thead>
                <tr>
                    <th class="text-left align-middle">
                        Detalle Bienes y Servicios
                    </th>
                    <th class="text-center align-middle">
                        Base imponible 0,5%
                    </th>
                    <th class="text-center align-middle">
                        Debito fiscal IVA 0,5%
                    </th>
                    <th class="text-center align-middle">
                        Base imponible 1%
                    </th>
                    <th class="text-center align-middle">
                        Debito fiscal IVA 1%
                    </th>
                    <th class="text-center align-middle">
                        Base imponible 2%
                    </th>
                    <th class="text-center align-middle">
                        Debito fiscal IVA 2%
                    </th>
                    <th class="text-center align-middle">
                        Base imponible 4%
                    </th>
                    <th class="text-center align-middle">
                        Debito fiscal IVA 4%
                    </th>
                    <th class="text-center align-middle">
                        Base imponible 8%
                    </th>
                    <th class="text-center align-middle">
                        Debito fiscal IVA 8%
                    </th>
                    <th class="text-center align-middle">
                        Base imponible 13%
                    </th>
                    <th class="text-center align-middle">
                        Debito fiscal IVA 13%
                    </th>
                    <th class="text-center align-middle">
                        Exento
                    </th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="props.model.data[0].taxes_scope" t-as="tax_scope" t-key="tax_scope['id']">
                    <tr t-on-click.stop="() => props.onRowClicked(tax_scope['id'], filter.value)">
                        <td t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span>
                                <t t-out="tax_scope['name']"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_base_05'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_base_05'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_amount_05'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_amount_05'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_base_1'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_base_1'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_amount_1'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_amount_1'] or 0)"/>
                            </span>
