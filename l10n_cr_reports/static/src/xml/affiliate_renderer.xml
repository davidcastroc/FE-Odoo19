                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_amount_13'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_amount_13'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['exempt_amount'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['exempt_amount'] or 0)"/>
                            </span>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </t>

<!--    <div t-name="l10n_cr_reports.AffiliateRenderer" class="o_activity_view">-->
    <div t-name="l10n_cr_reports.AffiliateRenderer" class="o_sales_funnel">
        <div class="row ml4 mt-2 mb-2">
            <div class="col-12 col-sm-12 col-md-3">
                <form class="form-group">
                    <b>Economic Activity:</b>
                    <select class='form-control' id="filter_economic_activity" name="filter_economic_activity"
                            t-on-change="() => props.onFilterEconomicActivity(filter.value)" t-model="filter.value">
                        <option value=''></option>
                        <t t-foreach="props.model.data[0].economic_activities" t-as="activity" t-key="activity['id']">
                            <option
                                    t-att-value="activity['id']">
                                <t t-esc="activity['name']"/>
                            </option>
                        </t>
                    </select>
                </form>
            </div>
        </div>

        <t t-call="l10n_cr_reports.AffiliateViewHeader"/>
    </div>
</templates>
