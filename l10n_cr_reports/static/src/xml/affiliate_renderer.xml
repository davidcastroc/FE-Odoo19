                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_amount_2'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_amount_2'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
