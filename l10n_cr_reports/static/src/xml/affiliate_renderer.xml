                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_amount_4'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_consu['taxed_base_8'] or 0)"/>
                            </span>
                            <span t-else="">
                                <t t-out="formatFloat(props.model.data[0].dict_sales_iva_service['taxed_base_8'] or 0)"/>
                            </span>
                        </td>
                        <td class="text-end" t-on-mouseover="onMouseEnter" t-on-mouseout="onMouseLeave">
                            <span t-if="tax_scope['id'] == 'consu'">
