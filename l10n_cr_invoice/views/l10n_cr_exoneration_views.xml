<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_cr_partner_exoneration_tree" model="ir.ui.view">
        <field name="name">view.l10n_cr.partner.exoneration.tree</field>
        <field name="model">l10n_cr.partner.exoneration</field>
        <field name="arch" type="xml">
            <list>
                <field name="exoneration_number"/>
                <field name="partner_id"/>
                <field name="institution_name"/>
                <field name="percentage_exoneration" string="% Exoneración"/>
                <field name="date_expiration"/>
                <field name="cabys_count"/>
<!--                <field name="days_to_expiry"/>-->
<!--                <field name="state"/>-->
<!--                <field name="active"/>-->
            </list>
        </field>
    </record>
    <record id="view_l10n_cr_partner_exoneration_form" model="ir.ui.view">
        <field name="name">view.l10n_cr.partner.exoneration.form</field>
        <field name="model">l10n_cr.partner.exoneration</field>
        <field name="arch" type="xml">
            <form>
<!--                <header>-->
<!--                    <field name="state" widget="statusbar"/>-->
<!--                </header>-->
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="exoneration_number"/>
                            <field name="institution_name"/>
                            <field name="exoneration_type_id"/>
                        </group>
                        <group>
                            <field name="percentage_exoneration" widget="percentage"
                                   help="Porcentaje de exoneración (ej: 0.13 = 13%)"/>
                            <field name="date_issue"/>
                            <field name="date_expiration"/>
<!--                            <field name="days_to_expiry" readonly="1"/>-->
<!--                            <field name="active"/>-->
                        </group>
                    </group>

<!--                    <group>-->
<!--                        <field name="description" placeholder="Descripción adicional..."/>-->
<!--                    </group>-->

                    <notebook>
                        <page string="Códigos CABYS">
                            <group>
                                <button name="action_reload_cabys"
                                        type="object"
                                        string="Recargar desde Hacienda"
                                        class="btn-primary"/>
                            </group>
                            <field name="allowed_cabys_line_ids" nolabel="1">
                                <list editable="bottom" decoration-warning="cabys_code != exoneration_code">
                                    <field name="product_id"/>
                                    <field name="cabys_code"/>
                                    <field name="exoneration_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

