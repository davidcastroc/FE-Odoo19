    <record id="action_l10n_cr_partner_exoneration" model="ir.actions.act_window">
        <field name="name">Exoneraciones de Clientes</field>
        <field name="res_model">l10n_cr.partner.exoneration</field>
        <field name="view_mode">list,form</field>
<!--        <field name="search_view_id" ref="view_partner_exoneration_search"/>-->
<!--        <field name="context">{-->
<!--            'search_default_active': 1,-->
<!--        }</field>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera exoneración!
            </p>
            <p>
                Registra las exoneraciones de tus clientes para aplicar
